{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "txn_id"],
  "properties": {
    "status": { "enum": ["accepted", "rejected"] },
    "txn_id": { "type": "string" },
    "reason": { "enum": ["adapter_rejected", "dead"] }
  }
}

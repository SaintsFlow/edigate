{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_document_id", "to", "template_id"],
  "properties": {
    "source_document_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "to": { "type": "string", "maxLength": 254, "pattern": "^[^@\\s<>,;]{1,64}@[^@\\s<>,;]{1,189}$" },
    "template_id": { "enum": ["tpl_order_received", "tpl_delivery_date", "tpl_contact_back"] }
  }
}

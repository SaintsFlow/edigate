{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["documents"],
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "st01", "partner_id", "business_ref", "received_at", "status"],
        "properties": {
          "id": { "type": "string" },
          "st01": { "type": "string" },
          "partner_id": { "type": "string" },
          "business_ref": { "type": "string" },
          "received_at": { "type": "string" },
          "status": { "enum": ["received", "processed", "rejected"] }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["partner_id", "business_ref", "ship_to", "lines"],
  "$defs": {
    "qty": {
      "anyOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]{1,12}(\\.[0-9]{1,3})?$" }
      ]
    }
  },
  "properties": {
    "partner_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "business_ref": { "type": "string", "minLength": 1, "maxLength": 64 },
    "ship_to": { "type": "string", "minLength": 1, "maxLength": 64 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "qty"],
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
          "qty": { "$ref": "#/$defs/qty" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["partner_id", "business_ref", "ship_to", "currency", "lines"],
  "$defs": {
    "qty": {
      "anyOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]{1,12}(\\.[0-9]{1,3})?$" }
      ]
    },
    "price": {
      "anyOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]{1,14}(\\.[0-9]{1,2})?$" }
      ]
    }
  },
  "properties": {
    "partner_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "business_ref": { "type": "string", "minLength": 1, "maxLength": 64 },
    "ship_to": { "type": "string", "minLength": 1, "maxLength": 64 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "delivery_instruction": { "type": "string", "maxLength": 500 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "qty", "unit", "unit_price"],
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
          "qty": { "$ref": "#/$defs/qty" },
          "unit": { "type": "string", "pattern": "^[A-Z0-9]{2}$" },
          "unit_price": { "$ref": "#/$defs/price" }
        }
      }
    }
  }
}

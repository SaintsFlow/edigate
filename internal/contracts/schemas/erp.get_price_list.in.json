{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sku"],
  "properties": {
    "sku": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,48}$" }
    }
  }
}

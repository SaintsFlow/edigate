# Copy to .env for local runs. Values below are empty or safe examples.
# Variables marked "not used yet" are reserved for parts of the gateway that are still being built.

# Required. PostgreSQL connection URL.
# The compose stand uses this one (user, password and database are all "edigate").
EDIGATE_DB_URL=postgres://edigate:edigate@127.0.0.1:55432/edigate?sslmode=disable

# Address the gateway listens on. Default 127.0.0.1:8080.
EDIGATE_LISTEN=127.0.0.1:8080

# Ed25519 private key (base64) that signs audit anchors. Not used yet.
EDIGATE_AUDIT_SIGNING_KEY=

# Directory outside the database where signed audit anchors are also written. Not used yet.
EDIGATE_AUDIT_ANCHOR_DIR=

# Ed25519 public key (base64) that verifies pinned tool manifests. Not used yet.
EDIGATE_MANIFEST_PUBKEY=

# Base URL of the OpenAI-compatible API used by the quarantined reader (edi.extract_note).
# From a container on Docker Desktop use http://host.docker.internal:11434/v1 for an Ollama on the host.
EDIGATE_QUARANTINE_BASE_URL=http://127.0.0.1:11434/v1

# Model name of the quarantined reader. Empty switches edi.extract_note off: it answers
# quarantine_invalid and the rest of the gateway works. A small fast model is enough.
EDIGATE_QUARANTINE_MODEL=llama3.2:3b

# API key of the quarantined reader, sent as a Bearer token only when set (empty for a local Ollama).
EDIGATE_QUARANTINE_API_KEY=

# Live test of the reader against a local model (skipped when empty), for example
# EDIGATE_TEST_OLLAMA_URL=http://127.0.0.1:11434/v1 go test -v -run Live ./internal/quarantine/...
EDIGATE_TEST_OLLAMA_URL=

# OpenRouter key for hosted models in the benchmark. Not used yet.
OPENROUTER_API_KEY=

# Ollama address for local models in the benchmark. Not used yet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
